# Copy this file to .env and fill in your own values.
# NEVER upload .env to GitHub.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prior_art
DB_USER=prior_art
DB_PASSWORD=your_mysql_password

# Authentication: use a long random value in your real .env
JWT_SECRET=replace_with_a_long_random_secret

# Anthropic AI
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Storage
# Use "local" for learning/testing on your own computer.
# Use "s3" for S3/R2/MinIO in a deployed setup.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3-compatible storage (only needed when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
